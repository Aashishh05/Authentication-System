# Root .gitignore for MERN Auth System

# Dependencies
client/node_modules/
server/node_modules/

# Environment variables (contains secrets!)
client/.env
server/.env

# Build output
client/dist/
server/dist/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/

# Misc
*.tsbuildinfo

# Claude Code local config (developer-specific)
.claude/
.mcp.json
CLAUDE.md